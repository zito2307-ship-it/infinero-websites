---
import '../styles/basis.css';
import '@theme';
import { inhalt, bild, variante } from '../lib/inhalt';
import Nav from '../bausteine/Nav.astro';
import Fuss from '../bausteine/Fuss.astro';
import DemoChat from '../bausteine/DemoChat.astro';
import { strukturdaten, ortsMeta, klar } from '../lib/seo';

const { titel, beschreibung, unterseite = false } = Astro.props;
const seo = inhalt.seo ?? {};
const t = titel ?? seo.titel ?? inhalt.firma.name;
const b = beschreibung ?? seo.beschreibung ?? '';
const noindex = inhalt.demo || inhalt.beispiel || inhalt.noindex;
// Farben je Kunde überschreiben (design.farben: { akzent: '#…', … })
const farben = Object.entries(inhalt.design?.farben ?? {}).map(([k, v]) => `--${k}:${v}`).join(';');
const chat = inhalt.funktionen.chat;
// SEO/GEO: Vorschaubild für geteilte Links (seo.bild, sonst Logo), Ortsangaben, strukturierte Daten (lib/seo.ts)
const teilBild = seo.bild ?? inhalt.design?.logo;
const absolut = (p: string) => (Astro.site ? new URL(p, Astro.site).href : p);
const ort = ortsMeta();
// Saubere Adresse ohne .html (Cloudflare liefert /impressum statt /impressum.html)
const pfad = Astro.url.pathname.replace(/index\.html$/, '').replace(/\.html$/, '');
const ld = unterseite ? [] : strukturdaten(Astro.site);
---
<!doctype html>
<html lang={inhalt.sprache}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{t}</title>
  {b && <meta name="description" content={b} />}
  {noindex && <meta name="robots" content="noindex" />}
  {Astro.site && <link rel="canonical" href={new URL(pfad, Astro.site)} />}
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="de_DE" />
  <meta property="og:site_name" content={klar(inhalt.firma.name)} />
  <meta property="og:title" content={t} />
  {b && <meta property="og:description" content={b} />}
  {Astro.site && <meta property="og:url" content={new URL(pfad, Astro.site)} />}
  {teilBild && <meta property="og:image" content={absolut(bild(teilBild))} />}
  <meta name="twitter:card" content={seo.bild ? 'summary_large_image' : 'summary'} />
  {ort.region && <meta name="geo.region" content={ort.region} />}
  {ort.ort && <meta name="geo.placename" content={ort.ort} />}
  {ort.position && <meta name="geo.position" content={ort.position} />}
  {ort.position && <meta name="ICBM" content={ort.position.replace(';', ', ')} />}
  <link rel="alternate" type="text/plain" href="/llms.txt" title="Kurzinfo für KI-Assistenten" />
  {ld.map((d: any) => <script is:inline type="application/ld+json" set:html={JSON.stringify(d).replace(/</g, '\\u003c')} />)}
  <link rel="icon" href={bild(inhalt.design?.favicon ?? 'favicon.svg')} />
  {farben && <style set:html={`:root:root{${farben}}`}></style>}
</head>
<body data-bewegung={inhalt.design?.bewegung ? '' : undefined}>
  {variante?.entwurf && <div class="demobar">✏️ <b>Entwurf {variante.id.toUpperCase()} – {variante.name}</b>{variante.beschreibung && ` · ${variante.beschreibung}`}</div>}
  {inhalt.demo && <div class="demobar">⚡ <b>Beispiel-Demo von Infinero</b> · {inhalt.demo_text ?? 'So könnte Ihre Website aussehen'} · <a href="https://infinero.de">Zu Infinero →</a></div>}
  <Nav basis={unterseite ? '/' : ''} />
  <main><slot /></main>
  <Fuss />
  {chat === 'demo' && <DemoChat />}
  {chat === 'snippet' && inhalt.funktionen.chat_snippet && <Fragment set:html={inhalt.funktionen.chat_snippet} />}
  <script>
    // Sanftes Einblenden beim Scrollen (nur mit design.bewegung, nicht bei reduzierter Bewegung / Prüfung)
    if (document.body.hasAttribute('data-bewegung') && !matchMedia('(prefers-reduced-motion: reduce)').matches && !navigator.webdriver) {
      const ziele = document.querySelectorAll('main section .kopf, .leistung, .person, .textbild > *, .vorteil, .bewertung, .faq, .formular, .detail-abschnitt');
      const beob = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('sichtbar'); beob.unobserve(e.target); } }), { threshold: 0.12 });
      ziele.forEach((z, i) => { z.setAttribute('data-einblenden', ''); (z as HTMLElement).style.transitionDelay = `${(i % 3) * 80}ms`; beob.observe(z); });
    }
    // Galerie-Slider: läuft endlos (Bilder werden unsichtbar wiederholt), Pause bei Maus/Fokus/Wischen, danach weiter
    document.querySelectorAll<HTMLElement>('[data-slider]').forEach((s) => {
      const spur = s.querySelector<HTMLElement>('.slider-spur')!;
      const original = [...spur.children] as HTMLElement[];
      if (original.length < 2) return;
      const kopieren = () => original.forEach((el) => {
        const k = el.cloneNode(true) as HTMLElement;
        k.setAttribute('aria-hidden', 'true'); k.removeAttribute('role'); k.removeAttribute('aria-label');
        spur.appendChild(k);
      });
      kopieren();
      const satz = () => (spur.children[original.length] as HTMLElement).offsetLeft - original[0].offsetLeft;
      for (let i = 0; i < 4 && spur.scrollWidth < 2 * satz() + spur.clientWidth; i++) kopieren();
      const schritt = () => original[0].offsetWidth + 16;
      const sofort = (x: number) => { spur.style.scrollBehavior = 'auto'; spur.scrollLeft = x; spur.style.scrollBehavior = ''; };
      // Nach jeder Bewegung unbemerkt in den ersten Satz zurückspringen – so gibt es kein Ende
      let ruhe: number | undefined;
      spur.addEventListener('scroll', () => {
        clearTimeout(ruhe);
        ruhe = window.setTimeout(() => { const w = satz(); if (spur.scrollLeft >= w) sofort(spur.scrollLeft - w); }, 160);
      }, { passive: true });
      const weiter = (r = 1) => {
        if (r < 0 && spur.scrollLeft < schritt() - 4) sofort(spur.scrollLeft + satz());
        spur.scrollTo({ left: spur.scrollLeft + r * schritt() });
      };
      s.querySelector('.weiter-knopf')?.addEventListener('click', () => weiter(1));
      s.querySelector('.zurueck-knopf')?.addEventListener('click', () => weiter(-1));
      let pause = false, wieder: number | undefined;
      const anhalten = () => { pause = true; clearTimeout(wieder); };
      const fortsetzen = (ms = 0) => { clearTimeout(wieder); wieder = window.setTimeout(() => (pause = false), ms); };
      ['mouseenter', 'focusin', 'touchstart'].forEach((ev) => s.addEventListener(ev, anhalten, { passive: true }));
      ['mouseleave', 'focusout'].forEach((ev) => s.addEventListener(ev, () => fortsetzen()));
      ['touchend', 'touchcancel'].forEach((ev) => s.addEventListener(ev, () => fortsetzen(4000), { passive: true }));
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) setInterval(() => { if (!pause && !document.hidden) weiter(1); }, 3500);
    });
    // Handy-Menü
    const mk = document.querySelector<HTMLButtonElement>('[data-menue-knopf]');
    const mm = document.getElementById('mobil-menue');
    if (mk && mm) {
      const setzen = (auf: boolean) => { mm.hidden = !auf; mk.setAttribute('aria-expanded', String(auf)); mk.setAttribute('aria-label', auf ? 'Menü schließen' : 'Menü öffnen'); };
      mk.addEventListener('click', () => setzen(mm.hidden));
      mm.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setzen(false)));
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setzen(false); });
    }
    // Formulare: Datum vorbelegen, absenden (oder Vorschau-Modus)
    const heute = new Date().toISOString().slice(0, 10);
    document.querySelectorAll<HTMLInputElement>('input[data-heute]').forEach((i) => { i.value = heute; i.min = heute; });
    document.querySelectorAll<HTMLFormElement>('form[data-anfrage]').forEach((form) => {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const daten = Object.fromEntries(new FormData(form).entries());
        if (daten.firma_website) return; // Spam-Falle
        delete daten.firma_website;
        const fehler = form.querySelector<HTMLElement>('.fehler')!;
        const knopf = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
        const endpunkt = form.dataset.endpunkt;
        knopf.disabled = true;
        try {
          if (endpunkt) {
            const r = await fetch(endpunkt, { method: 'POST', headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ kunde: form.dataset.kunde, art: form.dataset.art, seite: location.href, daten }) });
            if (!r.ok) throw new Error(String(r.status));
          }
          form.hidden = true;
          (form.nextElementSibling as HTMLElement).hidden = false;
        } catch {
          fehler.hidden = false;
          knopf.disabled = false;
        }
      });
    });
    // Karte erst nach Klick laden (2-Klick-Lösung)
    document.querySelectorAll<HTMLElement>('[data-karte]').forEach((k) => {
      k.querySelector('button')?.addEventListener('click', () => {
        k.innerHTML = `<iframe src="${k.dataset.karte}" title="Karte" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>`;
        k.classList.add('geladen');
      });
    });
    // Demo-Chat
    const fenster = document.querySelector<HTMLElement>('[data-chat]');
    const knopf = document.querySelector<HTMLButtonElement>('[data-chat-knopf]');
    if (fenster && knopf) {
      const cfg = JSON.parse(fenster.dataset.chat!);
      const verlauf = fenster.querySelector('.chat-verlauf')!;
      const eingabe = fenster.querySelector('input')!;
      const neu = (text: string, wer: string) => {
        const m = document.createElement('div'); m.className = `msg ${wer}`; m.textContent = text;
        verlauf.appendChild(m); verlauf.scrollTop = verlauf.scrollHeight;
      };
      knopf.addEventListener('click', () => {
        fenster.hidden = !fenster.hidden; knopf.setAttribute('aria-expanded', String(!fenster.hidden));
        if (!fenster.hidden) eingabe.focus();
      });
      fenster.querySelector('form')!.addEventListener('submit', (e) => {
        e.preventDefault();
        const v = eingabe.value.trim(); if (!v) return;
        neu(v, 'ich'); eingabe.value = '';
        const t = v.toLowerCase();
        const treffer = cfg.antworten.find((x: any) => x.w.some((w: string) => t.includes(w.toLowerCase())));
        setTimeout(() => neu(treffer ? treffer.a : cfg.sonst, 'bot'), 600);
      });
    }
  </script>
</body>
</html>
